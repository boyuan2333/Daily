<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExecutionContinuity.Domain\ExecutionContinuity.Domain.csproj" />
    <ProjectReference Include="..\ExecutionContinuity.Persistence\ExecutionContinuity.Persistence.csproj" />
  </ItemGroup>
  <Target Name="CopyApplicationPriToPublishDirectory" AfterTargets="Publish">
    <Error
      Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
      Text="The WinUI application PRI was not generated: $(TargetDir)$(AssemblyName).pri" />
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
    <Error
      Condition="!Exists('$(PublishDir)$(AssemblyName).pri')"
      Text="The WinUI application PRI was not copied to the publish directory: $(PublishDir)$(AssemblyName).pri" />
  </Target>
</Project>
