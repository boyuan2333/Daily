<Window
    x:Class="ExecutionContinuity.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Daily">
    <Grid x:Name="RootGrid" Background="#F8FAF5" RequestedTheme="Light" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppHeader" Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E6E0" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Daily" FontSize="28" FontWeight="SemiBold" Foreground="#4A845E" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#F0F3EE" CornerRadius="18" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="200" Height="36">
                    <Border x:Name="ModeSelectionIndicator"
                            Width="100"
                            Background="#4A845E"
                            CornerRadius="18"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ModeSelectionTransform" />
                        </Border.RenderTransform>
                    </Border>
                    <Button x:Name="GuideModeButton" Width="100" HorizontalAlignment="Left" CornerRadius="18" Content="引导" Click="GuideButton_Click" Background="Transparent" BorderBrush="Transparent" Foreground="White" Padding="0" MinHeight="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button x:Name="PlanningModeButton" Width="100" HorizontalAlignment="Right" CornerRadius="18" Content="规划" Click="PlanningButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="0" MinHeight="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
            </Border>
            <Button Grid.Column="2" x:Name="SettingsButton" Click="SettingsButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12" MinHeight="36" VerticalAlignment="Center" ToolTipService.ToolTip="设置">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="18" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" x:Name="ContentGrid">
            <ScrollViewer x:Name="MainContentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GuidePanel" MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="32,52,32,88" Spacing="22">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="GuideRouteText" Foreground="#2A5A3B" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="GuideProgressText" Foreground="#66706A" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#4A845E" BorderThickness="4,1,1,1" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="GuideHeading" Foreground="#2A5A3B" FontWeight="SemiBold" />
                                <TextBlock x:Name="GuideActionText" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="GuidancePanel" Spacing="12">
                            <TextBlock Text="上下文与指南" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="完成标准" FontWeight="SemiBold" Foreground="#2A5A3B" />
                                        <TextBlock x:Name="CompletionText" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FFF8F7" BorderBrush="#DAB9B1" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="边界" FontWeight="SemiBold" Foreground="#A13B31" />
                                        <TextBlock x:Name="BoundaryText" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="NormalControls" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button x:Name="CompleteCurrentButton" Content="完成此动作" Click="CompleteCurrentButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                            <Button x:Name="StuckButton" Content="我卡住了" Click="StuckButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                        </StackPanel>
                        <StackPanel x:Name="FallbackControls" Spacing="10" HorizontalAlignment="Center">
                            <Button Content="已完成备选动作，回到原动作" Click="CompleteFallbackButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                        </StackPanel>
                        <StackPanel x:Name="BlockedControls" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="已保存返回点。" HorizontalAlignment="Center" Foreground="#66706A" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                <Button Content="回到当前动作" Click="ReturnFromBlockedButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                                <Button Content="现在暂停，之后从这里继续" Click="PauseFromBlockedButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="BlockEntryPanel" Spacing="10" HorizontalAlignment="Stretch" MaxWidth="560">
                            <TextBlock Text="用一句话记录卡点。" />
                            <Border x:Name="BlockInputSurface" Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                <TextBox x:Name="BlockInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="一句话即可" MaxLength="280" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="保存返回点" Click="SaveBlockButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                                <Button Content="返回" Click="CancelBlockButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="PausePanel" Background="#FFFFFF" CornerRadius="8" Padding="18" HorizontalAlignment="Stretch" MaxWidth="560">
                            <StackPanel Spacing="10">
                                <Border x:Name="PauseNoteInputSurface" Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                    <TextBox x:Name="PauseNoteInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="可选的暂停备注" AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="保存返回点" Click="PauseButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                                    <Button Content="暂停并选择其他路线" Click="PauseAndChooseAnotherRouteButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="NoActivePanel" MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="32" Spacing="18">
                        <Border Width="82" Height="82" Background="#FFFFFF" BorderBrush="#E2E6E0" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" FontSize="30" Foreground="#4A845E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="当前没有正在执行的路线" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="准备好后，可规划下一条执行路线，或先捕捉刚出现的想法。" Foreground="#66706A" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="430" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button Content="进入规划" Click="PlanningButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                            <Button Content="捕捉想法" Click="OpenCaptureButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="PlanningPanel" Margin="0" SizeChanged="PlanningPanel_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PlanningNavigationColumn" Width="196" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PlanningNavigationSurface" Background="#F3F4EF" BorderBrush="#E1E6E0" BorderThickness="0,0,1,0" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PlanningTitleText" Text="规划" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock x:Name="PlanningSubtitleText" Text="管理" Foreground="#66706A" Margin="0,0,0,18" />
                                <Button x:Name="RoutesNavButton" Content="路线" Click="RoutesNavButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="12,8" MinHeight="36" HorizontalAlignment="Stretch" />
                                <Button x:Name="InboxNavButton" Content="收件箱" Click="InboxNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" HorizontalAlignment="Stretch" />
                                <Button x:Name="ArchiveNavButton" Content="归档" Click="ArchiveNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" x:Name="RoutesWorkspace" Padding="24,20" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RouteListColumn" Width="280" />
                                <ColumnDefinition x:Name="RouteEditorColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="RouteListRow" Height="*" />
                                <RowDefinition x:Name="RouteEditorRow" Height="0" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="CompactRoutesNavigation" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button Content="路线" Click="RoutesNavButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="12,8" MinHeight="36" />
                                <Button Content="收件箱" Click="InboxNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                                <Button Content="归档" Click="ArchiveNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                            </StackPanel>
                            <Border x:Name="RouteListSurface" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E6E0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="RoutesTitleText" Text="路线" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox x:Name="RouteSearchInput" PlaceholderText="搜索路线标题或下一动作" TextChanged="RouteSearchInput_TextChanged" MinHeight="36" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="RoutesByStatusButton" Content="按状态" Click="RoutesByStatusButton_Click" Padding="10,6" MinHeight="34" />
                                            <Button x:Name="RoutesByProjectButton" Content="按项目" IsEnabled="False" Padding="10,6" MinHeight="34" ToolTipService.ToolTip="领域模型尚未提供项目归属" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer x:Name="RouteListScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="RouteListPanel" Spacing="10" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="RouteEditorScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="16" MaxWidth="700">
                                    <Grid>
                                        <TextBlock Text="准备一条路线" FontSize="24" FontWeight="SemiBold" />
                                        <Button x:Name="RouteBackButton" Content="返回路线列表" Click="RouteBackButton_Click" Visibility="Collapsed" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                                    </Grid>
                                    <Border Background="#F3F4EF" BorderBrush="#E1E6E0" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel Spacing="10">
                                            <Border x:Name="RouteTitleInputSurface" Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                                <TextBox x:Name="RouteTitleInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="路线标题" />
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                                <TextBox x:Name="RouteActionInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="第一个可执行动作" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                                <TextBox x:Name="CompletionStandardInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="完成标准" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                                <TextBox x:Name="DoNotDoInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="不要做什么" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="8" MinHeight="44">
                                                <TextBox x:Name="FallbackActionInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="可选的预设备选动作" AcceptsReturn="True" TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button x:Name="AddStepButton" Click="AddStepButton_Click" Style="{StaticResource PlanningSecondaryButtonStyle}" Resources="{StaticResource PlanningSecondaryButtonResources}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="14" />
                                                        <TextBlock Text="添加步骤" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="清空步骤" Click="ClearStepButton_Click" Style="{StaticResource PlanningDestructiveButtonStyle}" Resources="{StaticResource PlanningDestructiveButtonResources}" />
                                            </StackPanel>
                                            <StackPanel x:Name="DraftStepsPanel" Spacing="6" />
                                            <Button x:Name="SaveRouteButton" Content="保存草稿路线" Click="CreateRouteButton_Click" Style="{StaticResource PlanningPrimaryButtonStyle}" Resources="{StaticResource PlanningPrimaryButtonResources}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid Grid.Column="1" x:Name="InboxWorkspace" Padding="24,20" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="InboxListColumn" Width="300" />
                                <ColumnDefinition x:Name="InboxDetailColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="InboxListRow" Height="*" />
                                <RowDefinition x:Name="InboxDetailRow" Height="0" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="CompactInboxNavigation" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button Content="路线" Click="RoutesNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                                <Button Content="收件箱" Click="InboxNavButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="12,8" MinHeight="36" />
                                <Button Content="归档" Click="ArchiveNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                            </StackPanel>
                            <Border x:Name="InboxListSurface" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1E6E0" BorderThickness="1" CornerRadius="12" Padding="16">
                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="InboxTitleText" Text="收件箱" FontSize="20" FontWeight="SemiBold" />
                                        <TextBox x:Name="InboxSearchInput" PlaceholderText="搜索原文或整理内容" TextChanged="InboxSearchInput_TextChanged" MinHeight="36" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="InboxAllButton" Content="全部" Click="InboxFilterButton_Click" Tag="All" Padding="10,6" MinHeight="34" />
                                        <Button x:Name="InboxUnorganizedButton" Content="未整理" Click="InboxFilterButton_Click" Tag="Unorganized" Padding="10,6" MinHeight="34" />
                                        <Button x:Name="InboxOrganizedButton" Content="已整理" Click="InboxFilterButton_Click" Tag="Organized" Padding="10,6" MinHeight="34" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="InboxListScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="InboxPanel" Spacing="10" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Grid.Column="1" x:Name="InboxDetailWorkspace" VerticalAlignment="Stretch">
                                <StackPanel x:Name="InboxDetailPanel" Spacing="16" Padding="0,48,0,0" VerticalAlignment="Top" />
                                <Button x:Name="InboxBackButton" Content="返回收件箱列表" Click="InboxBackButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" x:Name="ArchiveWorkspace" Padding="32,24" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="CompactArchiveNavigation" Grid.Row="0" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button Content="路线" Click="RoutesNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                                <Button Content="收件箱" Click="InboxNavButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="12,8" MinHeight="36" />
                                <Button Content="归档" Click="ArchiveNavButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="12,8" MinHeight="36" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="14" Margin="0,18,0,0">
                                <TextBlock Text="归档" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="归档内容会保留，并可在规划中恢复。" Foreground="#66706A" />
                                <TextBlock Text="当前版本会在路线和收件箱条目中显示归档状态。" Foreground="#66706A" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="SettingsPanel" MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="32" Spacing="18">
                        <TextBlock x:Name="SettingsTitleText" Text="设置" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <Border Background="#FFFFFF" BorderBrush="#D8DED7" BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="LanguageTitleText" Text="语言" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="LanguageSystemButton" Content="跟随系统" Click="LanguagePreferenceButton_Click" Tag="FollowSystem" Padding="12,8" MinHeight="36" />
                                    <Button x:Name="LanguageChineseButton" Content="简体中文" Click="LanguagePreferenceButton_Click" Tag="SimplifiedChinese" Padding="12,8" MinHeight="36" />
                                    <Button x:Name="LanguageEnglishButton" Content="English" Click="LanguagePreferenceButton_Click" Tag="English" Padding="12,8" MinHeight="36" />
                                </StackPanel>
                                <TextBlock x:Name="LanguageCurrentText" FontWeight="SemiBold" Foreground="#2A5A3B" />
                                <TextBlock x:Name="LanguageDescriptionText" Foreground="#66706A" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CloseSettingsButton" Content="返回" Click="CloseSettingsButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </Grid>

        <Border x:Name="BottomActionBar" Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1E6E0" BorderThickness="0,1,0,0" Padding="24,7">
            <Button x:Name="CaptureFooterButton" Content="捕捉想法" Click="OpenCaptureButton_Click" MaxWidth="520" CornerRadius="22" Background="#F5F7F4" Foreground="#385D44" BorderBrush="#D8DED7" BorderThickness="1" Padding="22,10" MinHeight="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </Border>

        <Grid x:Name="CaptureOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#66000000" Canvas.ZIndex="20" TabFocusNavigation="Cycle">
            <Border x:Name="CaptureDrawer" MaxWidth="410" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#FFFFFF" BorderBrush="#D8DED7" BorderThickness="1,0,0,0" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="捕捉想法" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="这不会改变当前路线或当前动作。" Foreground="#66706A" TextWrapping="Wrap" />
                    <Border x:Name="CaptureInputSurface" Background="#FFFFFF" BorderBrush="#B8C4B9" BorderThickness="1" CornerRadius="12" MinHeight="160">
                        <TextBox x:Name="CaptureInput" Background="Transparent" BorderThickness="0" Padding="14,10" FontFamily="Microsoft YaHei UI" FontSize="15" PlaceholderText="写下想法……" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存" Click="CaptureButton_Click" Background="#4A845E" Foreground="White" BorderBrush="#4A845E" Padding="18,10" MinHeight="42" />
                        <Button Content="取消" Click="CloseCaptureButton_Click" Background="#FFFFFF" Foreground="#202521" BorderBrush="#D8DED7" BorderThickness="1" Padding="16,10" MinHeight="42" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520" Margin="16,18" Canvas.ZIndex="30" />
    </Grid>
</Window>
